<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="CineWeb.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <table>
            <tr>
                <td colspan="2" style="text-align:center;">
                    <!-- Aqui va el logo-->
                    <img src="~/static/cinew.png" runat="server" alt="Logo CineWeb" id="imgLogo" />
                </td>
            </tr>
            <tr>
                <td>
                    <!-- Aquí va el menú de navegación -->
                    <asp:SiteMapDataSource ID="SiteMapDataSource1" runat="server" /> <!-- SiteMapDataSource1 lee automaticamente el archivo web.sitemap sin indicarle la ruta-->
                    <asp:Menu ID="MenuNavegacion" runat="server" DataSourceID="SiteMapDataSource1" Orientation="Horizontal">
                    </asp:Menu>
                </td>
                <td>
                    <!-- Aquí va el formulario de búsqueda avanzada -->
                    <asp:Label ID="lblBusqueda" runat="server" Text="Ingrese el filtro de búsqueda"></asp:Label>
                    <asp:TextBox ID="txtFiltro" runat="server"></asp:TextBox>
                    <asp:Button ID="btnBuscar" runat="server" Text="Buscar" OnClick="btnBuscar_Click" />
                </td>
            </tr>
            <tr>
                <td colspan="2">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
        </table>
    </form>
</body>
</html>
